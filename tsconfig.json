{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "types": ["bun", "node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@office/model": ["packages/model/src/index.ts"],
      "@office/spreadsheet": ["packages/spreadsheet/src/index.ts"],
      "@office/collaboration": ["packages/collaboration/src/index.ts"],
      "@office/ui": ["packages/ui/src/index.tsx"]
    }
  },
  "include": ["apps", "packages", "scripts", "tests", "playwright.config.ts"]
}
