{
  "name": "office",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts desktop",
    "dev:web": "bun scripts/dev.ts web",
    "backend:build": "bun scripts/build.ts backend",
    "build": "bun scripts/build.ts",
    "build:web": "bun --cwd apps/web run build",
    "start:web": "bun scripts/serve.ts",
    "desktop": "bun scripts/desktop.ts",
    "package": "bun scripts/package.ts",
    "package:dir": "bun scripts/package.ts --dir",
    "typecheck": "tsc --noEmit",
    "test": "bun test && bun run test:backend",
    "test:backend": "bun scripts/test-backend.ts",
    "test:e2e": "playwright test",
    "test:race": "bun scripts/test-backend.ts --race",
    "format": "prettier --write apps packages scripts tests docs *.json *.md *.ts"
  },
  "devDependencies": {
    "yjs": "^13.6.27",
    "vite": "^7.1.0",
    "@playwright/test": "^1.55.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/turndown": "^5.0.5",
    "typescript": "^5.9.0",
    "prettier": "^3.6.0"
  }
}
